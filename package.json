{
  "name": "bigfightside-website",
  "version": "1.0.0",
  "private": true,
  "description": "Big Fight Side – MMA-Plattform mit Payload CMS",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "npm run migrate:ci && payload generate:types && next build",
    "start": "next start",
    "lint": "next lint",
    "test:db": "node --env-file=.env scripts/test-db.mjs",
    "payload": "node --env-file=.env ./node_modules/payload/bin.js",
    "generate:types": "node --env-file=.env ./node_modules/payload/bin.js generate:types",
    "migrate:create": "node --env-file=.env ./node_modules/payload/bin.js migrate:create",
    "migrate": "node --env-file=.env scripts/test-db.mjs && node --env-file=.env ./node_modules/payload/bin.js migrate",
    "migrate:ci": "node scripts/clean-dev-migrations.mjs && node ./node_modules/payload/bin.js migrate",
    "migrate:via-app": "node --env-file=.env scripts/migrate-via-app.mjs",
    "seed:global-mma": "npx tsx src/scripts/seedGlobalMMA.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/ui": "^3.0.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parser": "^3.2.0",
    "graphql": "^16.8.1",
    "lucide-react": "^0.577.0",
    "next": "15.4.11",
    "papaparse": "^5.5.3",
    "payload": "^3.0.0",
    "postgres": "^3.4.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.0.6",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.3.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.4.11",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
