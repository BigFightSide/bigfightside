DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx

# The Odds API (für /events – MMA/UFC Kämpfe)
# https://the-odds-api.com
ODDS_API_KEY=...


